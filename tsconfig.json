{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "jsx": "react",
    "outDir": "./build",
    "noImplicitOverride": true,
    // The shadcn CLI resolves the "~" alias of components.json through this file, not inertia/tsconfig.json.
    "paths": { "~/*": ["./inertia/*"] }
  },
  "references": [{ "path": "./tsconfig.inertia.json" }]
}
