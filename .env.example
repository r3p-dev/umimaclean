# Node
TZ=UTC
PORT=3333
# Note: test runs automatically use PORT=3334 from .env.test to avoid port conflicts with a running dev server (D71).
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Addresses allowed to set X-Forwarded-For (comma-separated IPs, CIDR ranges or loopback).
# Production: the Podman network of the reverse proxy, for example 10.89.0.0/24.
TRUSTED_PROXIES=loopback

# Session
SESSION_DRIVER=database

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_DATABASE=umimaclean_dev

# Auth & WhatsApp
ADMIN_PHONE=081298765432
WHATSAPP_ALLOWED_PHONES=081298765432
FONNTE_TOKEN=

# Limiter
LIMITER_STORE=database

# Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=true

# Maps: the PMTiles file in public/tiles/ (docs/SETUP.md Step 5); empty = plain map background
MAP_TILES_FILE=bandung-raya-20261112.pmtiles
